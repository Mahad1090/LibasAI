migrate_working_dir/

# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/

# VS Code — workspace settings are intentionally tracked (.vscode/settings.json).
# Ignore only the machine-specific bits.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Flutter / Dart / Pub
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
# NOTE: pubspec.lock IS committed for applications.

# Symbolication / obfuscation
app.*.symbols
app.*.map.json

# Android build artifacts placed here by Android Studio
/android/app/debug
/android/app/profile
/android/app/release

# Web / desktop build output (covered by /build, listed for clarity)
/web/build/

# Local env / secrets
*.env
.env.local
**/*.keystore
**/*.jks
key.properties

# Claude Code scratch (not part of the app)
.github/modernize/
