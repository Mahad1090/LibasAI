# Normalise line endings — store LF in the repo, check out native on Windows.
* text=auto eol=lf

*.bat        text eol=crlf
*.ps1        text eol=crlf

# Binary assets — never touch.
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.ttf        binary
*.otf        binary
*.jar        binary
*.keystore   binary
*.jks        binary
