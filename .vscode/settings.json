{
  // Keep the Dart analysis server lighter on this 8 GB machine.
  "dart.analysisExcludedFolders": ["build", ".dart_tool", "android", "ios", "web", "windows", "linux", "macos"],
  "dart.experimentalRefactors": false,
  "dart.previewFlutterUiGuides": false,
  "dart.previewFlutterUiGuidesCustomTracking": false,
  "dart.closingLabels": false,
  "dart.showInspectorNotificationsForWidgetErrors": false,
  "dart.flutterHotReloadOnSave": "manual",
  "files.watcherExclude": {
    "**/build/**": true,
    "**/.dart_tool/**": true,
    "**/android/**": true,
    "**/ios/**": true
  }
}
